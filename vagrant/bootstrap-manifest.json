[
  {
    "id": "require-env",
    "action": "require-env",
    "vars": ["CLUSTER_DOMAIN"]
  },
  {
    "id": "resource-check",
    "action": "resource-check",
    "ports": [
      { "port": 80 },
      { "port": 443 },
      { "port": 5002 },
      { "port": 1111 }
    ]
  },
  {
    "id": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD_PEERS": "{{ range $ip := .SortedHostIPs }}{{ $ip }}:1111,{{ end }}",
        "DISCOVERD": "none",
        "DEBUG": "{{ getenv \"DEBUG\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 1111, "proto": "tcp"}, {"port": 53, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "host_network": true,
          "omni": true,
          "service": "discoverd"
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=discoverd\u0026target=/images/53c5308c8ac93684b325caf89f15ee6db67da31929efce8b9b789b282c0403b8.json","meta":{"flynn.component":"discoverd","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-discoverd"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"965c059761d83f3f3b677575a2739e06e5677d36be23461c8c93c4d36d0a6cf5"},"id":"965c059761d83f3f3b677575a2739e06e5677d36be23461c8c93c4d36d0a6cf5","length":6918144,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"53c5308c8ac93684b325caf89f15ee6db67da31929efce8b9b789b282c0403b8"},"size":652,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"}
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD": "none",
        "BACKEND": "{{ getenv \"FLANNEL_BACKEND\" }}",
        "NETWORK": "{{ getenv \"FLANNEL_NETWORK\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 5002, "proto": "tcp"}],
          "host_network": true,
          "omni": true
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=flannel\u0026target=/images/2d2ead58516651c35d50cf15489c320f466686090b6f81dee3012baa002a68be.json","meta":{"flynn.component":"flannel","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/flannel-wrapper"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"5ae971531d3d931ab58eb15134ecc05c33cdc5646e41e3eb81d1c14939a2cf69"},"id":"5ae971531d3d931ab58eb15134ecc05c33cdc5646e41e3eb81d1c14939a2cf69","length":11317248,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"2d2ead58516651c35d50cf15489c320f466686090b6f81dee3012baa002a68be"},"size":653,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "wait-hosts",
    "action": "wait-hosts"
  },
  {
    "id": "pg-password",
    "action": "gen-random"
  },
  {
    "id": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "FLYNN_POSTGRES": "postgres",
        "PGDATABASE": "postgres",
        "PGHOST": "leader.postgres.discoverd",
        "PGUSER": "flynn",
        "PGPASSWORD": "{{ (index .StepData \"pg-password\").Data }}",
        "SIRENIA_PROCESS": "postgres",
        "SINGLETON": "{{ .Singleton }}"
      },
      "processes": {
        "postgres": {
          "ports": [{"port": 5432, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "args": ["/bin/start-flynn-postgres", "postgres"],
          "service": "postgres"
        },
        "web": {
          "ports": [{"port": 80, "proto": "tcp"}],
          "args": ["/bin/start-flynn-postgres", "api"]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=postgres\u0026target=/images/75c91198b93127a9fad03e92beaecd9487c0b6deb565cf3d548d005be4c4cad5.json","meta":{"flynn.component":"postgres","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-postgres"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"6805bf3fa1b86036f55ff72be0877dd8b9c653477c544326047e0982b417840e"},"id":"6805bf3fa1b86036f55ff72be0877dd8b9c653477c544326047e0982b417840e","length":167006208,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"946b93492edf593c3063297cef39ee7ce979753653d5e6f6f54871509de4e12e"},"id":"946b93492edf593c3063297cef39ee7ce979753653d5e6f6f54871509de4e12e","length":433618944,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"2c9e88af63af299ecd57d422e63726cf0c6cd192d5b71b107d64b8262eb08976"},"id":"2c9e88af63af299ecd57d422e63726cf0c6cd192d5b71b107d64b8262eb08976","length":12922880,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"75c91198b93127a9fad03e92beaecd9487c0b6deb565cf3d548d005be4c4cad5"},"size":893,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "postgres": 3,
      "web": 2
    }
  },
  {
    "id": "controller-key",
    "action": "gen-random",
    "controller_key": true,
    "data": "{{ getenv \"CONTROLLER_KEY\" }}"
  },
  {
    "id": "bootstrap-id",
    "action": "gen-random",
    "encoding": "uuid"
  },
  {
    "id": "dashboard-session-secret",
    "action": "gen-random"
  },
  {
    "id": "dashboard-login-token",
    "action": "gen-random"
  },
  {
    "id": "name-seed",
    "action": "gen-random",
    "length": 10
  },
  {
    "id": "router-sticky-key",
    "action": "gen-random",
    "length": 32,
    "encoding": "base64"
  },
  {
    "id": "postgres-wait",
    "action": "wait",
    "url": "http://postgres-api.discoverd/ping"
  },
  {
    "id": "controller-cert",
    "action": "gen-tls-cert",
    "hosts": ["{{ getenv \"CLUSTER_DOMAIN\" }}", "*.{{ getenv \"CLUSTER_DOMAIN\" }}"],
    "ca_cert": "{{ getenv \"TLS_CA\" }}",
    "cert": "{{ getenv \"TLS_CERT\" }}",
    "key": "{{ getenv \"TLS_KEY\" }}"
  },
  {
    "id": "controller",
    "action": "run-app",
    "app": {
      "name": "controller",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "release": {
      "env": {
        "AUTH_KEY": "{{ (index .StepData \"controller-key\").Data }}",
        "DEFAULT_ROUTE_DOMAIN": "{{ getenv \"CLUSTER_DOMAIN\" }}",
        "NAME_SEED": "{{ (index .StepData \"name-seed\").Data }}",
        "CA_CERT": "{{ (index .StepData \"controller-cert\").CACert }}",
        "TELEMETRY_BOOTSTRAP_ID": "{{ (index .StepData \"bootstrap-id\").Data }}",
        "TELEMETRY_CLUSTER_ID": "{{ (index .StepData \"bootstrap-id\").Data }}"
      },
      "processes": {
        "web": {
          "ports": [
            {"port": 80, "proto": "tcp"},
            {"port": 8080, "proto": "tcp"}
          ],
          "args": ["/bin/start-flynn-controller", "controller"],
          "service": "controller",
          "volumes": [{"path": "/tmp", "delete_on_stop": true}]
        },
        "scheduler": {
          "args": ["/bin/start-flynn-controller", "scheduler"],
          "omni": true,
          "service": "controller-scheduler",
          "ports": [{ "proto": "tcp" }]
        },
        "worker": {
          "args": ["/bin/start-flynn-controller", "worker"],
          "ports": [{ "proto": "tcp" }]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=controller\u0026target=/images/fc7e85b57424425367e0f7ee598f79990313248aa1305ab0ebcb0089640a6220.json","meta":{"flynn.component":"controller","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-controller"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"9671725fa08c46396f66591070f7834462765a50025f38b54663fcbbd1fe7d88"},"id":"9671725fa08c46396f66591070f7834462765a50025f38b54663fcbbd1fe7d88","length":24190976,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"fc7e85b57424425367e0f7ee598f79990313248aa1305ab0ebcb0089640a6220"},"size":660,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "web": 1
    },
    "resources": [{"name":"postgres", "url":"http://postgres-api.discoverd/databases"}]
  },
  {
    "id": "controller-wait",
    "action": "wait",
    "url": "http://controller.discoverd",
    "status": 401
  },
  {
    "id": "controller-inception",
    "action": "add-app",
    "from_step": "controller",
    "app": {
      "name": "controller",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one",
      "deploy_timeout": 120
    }
  },
  {
    "id": "postgres-app",
    "action": "add-app",
    "from_step": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "sirenia",
      "deploy_timeout": 120
    }
  },
  {
    "id": "flannel-app",
    "action": "add-app",
    "from_step": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one"
    }
  },
  {
    "id": "discoverd-app",
    "action": "add-app",
    "from_step": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "discoverd-meta",
      "deploy_timeout": 300
    }
  },
  {
    "id": "scheduler-scale",
    "action": "scale-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1,
      "worker": 2,
      "web": 2
    }
  },
  {
    "id": "scheduler",
    "action": "run-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1
    }
  },
