[
  {
    "id": "require-env",
    "action": "require-env",
    "vars": ["CLUSTER_DOMAIN"]
  },
  {
    "id": "resource-check",
    "action": "resource-check",
    "ports": [
      { "port": 80 },
      { "port": 443 },
      { "port": 5002 },
      { "port": 1111 }
    ]
  },
  {
    "id": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD_PEERS": "{{ range $ip := .SortedHostIPs }}{{ $ip }}:1111,{{ end }}",
        "DISCOVERD": "none",
        "DEBUG": "{{ getenv \"DEBUG\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 1111, "proto": "tcp"}, {"port": 53, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "host_network": true,
          "omni": true,
          "service": "discoverd"
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=discoverd\u0026target=/images/c40de25e645327946ef4d6a54bff9d3fbfc3ed83de2fbb2bda707b6eff37e857.json","meta":{"flynn.component":"discoverd","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-discoverd"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"e1775ce512b09dc969c475284d739b774baa39c7fbfb1f0a060fc20d98b97173"},"id":"e1775ce512b09dc969c475284d739b774baa39c7fbfb1f0a060fc20d98b97173","length":6918144,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"c40de25e645327946ef4d6a54bff9d3fbfc3ed83de2fbb2bda707b6eff37e857"},"size":652,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"}
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD": "none",
        "BACKEND": "{{ getenv \"FLANNEL_BACKEND\" }}",
        "NETWORK": "{{ getenv \"FLANNEL_NETWORK\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 5002, "proto": "tcp"}],
          "host_network": true,
          "omni": true
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=flannel\u0026target=/images/40a3a69cdb6d316637f9bb1de17b523535c5c3fe2fa1fbed362a6ee8dd683db2.json","meta":{"flynn.component":"flannel","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/flannel-wrapper"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"61ef56749dca16fc8c7b5c8c1849f64dcb9c811bcdad53690debfcdfed831e1a"},"id":"61ef56749dca16fc8c7b5c8c1849f64dcb9c811bcdad53690debfcdfed831e1a","length":11317248,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"40a3a69cdb6d316637f9bb1de17b523535c5c3fe2fa1fbed362a6ee8dd683db2"},"size":653,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "wait-hosts",
    "action": "wait-hosts"
  },
  {
    "id": "pg-password",
    "action": "gen-random"
  },
  {
    "id": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "FLYNN_POSTGRES": "postgres",
        "PGDATABASE": "postgres",
        "PGHOST": "leader.postgres.discoverd",
        "PGUSER": "flynn",
        "PGPASSWORD": "{{ (index .StepData \"pg-password\").Data }}",
        "SIRENIA_PROCESS": "postgres",
        "SINGLETON": "{{ .Singleton }}"
      },
      "processes": {
        "postgres": {
          "ports": [{"port": 5432, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "args": ["/bin/start-flynn-postgres", "postgres"],
          "service": "postgres"
        },
        "web": {
          "ports": [{"port": 80, "proto": "tcp"}],
          "args": ["/bin/start-flynn-postgres", "api"]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=postgres\u0026target=/images/247d9bc6ee80981ae67f262874c0623976756253181df73a474c19e00b392510.json","meta":{"flynn.component":"postgres","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-postgres"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"6805bf3fa1b86036f55ff72be0877dd8b9c653477c544326047e0982b417840e"},"id":"6805bf3fa1b86036f55ff72be0877dd8b9c653477c544326047e0982b417840e","length":167006208,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"946b93492edf593c3063297cef39ee7ce979753653d5e6f6f54871509de4e12e"},"id":"946b93492edf593c3063297cef39ee7ce979753653d5e6f6f54871509de4e12e","length":433618944,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"ddafc6569e7d7c0f9c3485fd2e165cc59847113f91908e7d127806dd43225978"},"id":"ddafc6569e7d7c0f9c3485fd2e165cc59847113f91908e7d127806dd43225978","length":12922880,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"247d9bc6ee80981ae67f262874c0623976756253181df73a474c19e00b392510"},"size":893,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "postgres": 3,
      "web": 2
    }
  },
  {
    "id": "controller-key",
    "action": "gen-random",
    "controller_key": true,
    "data": "{{ getenv \"CONTROLLER_KEY\" }}"
  },
  {
    "id": "bootstrap-id",
    "action": "gen-random",
    "encoding": "uuid"
  },
  {
    "id": "dashboard-session-secret",
    "action": "gen-random"
  },
  {
    "id": "dashboard-login-token",
    "action": "gen-random"
  },
  {
    "id": "name-seed",
    "action": "gen-random",
    "length": 10
  },
  {
    "id": "router-sticky-key",
    "action": "gen-random",
    "length": 32,
    "encoding": "base64"
  },
  {
    "id": "postgres-wait",
    "action": "wait",
    "url": "http://postgres-api.discoverd/ping"
  },
  {
    "id": "controller-cert",
    "action": "gen-tls-cert",
    "hosts": ["{{ getenv \"CLUSTER_DOMAIN\" }}", "*.{{ getenv \"CLUSTER_DOMAIN\" }}"],
    "ca_cert": "{{ getenv \"TLS_CA\" }}",
    "cert": "{{ getenv \"TLS_CERT\" }}",
    "key": "{{ getenv \"TLS_KEY\" }}"
  },
  {
    "id": "controller",
    "action": "run-app",
    "app": {
      "name": "controller",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "release": {
      "env": {
        "AUTH_KEY": "{{ (index .StepData \"controller-key\").Data }}",
        "DEFAULT_ROUTE_DOMAIN": "{{ getenv \"CLUSTER_DOMAIN\" }}",
        "NAME_SEED": "{{ (index .StepData \"name-seed\").Data }}",
        "CA_CERT": "{{ (index .StepData \"controller-cert\").CACert }}",
        "TELEMETRY_BOOTSTRAP_ID": "{{ (index .StepData \"bootstrap-id\").Data }}",
        "TELEMETRY_CLUSTER_ID": "{{ (index .StepData \"bootstrap-id\").Data }}"
      },
      "processes": {
        "web": {
          "ports": [
            {"port": 80, "proto": "tcp"},
            {"port": 8080, "proto": "tcp"}
          ],
          "args": ["/bin/start-flynn-controller", "controller"],
          "service": "controller",
          "volumes": [{"path": "/tmp", "delete_on_stop": true}]
        },
        "scheduler": {
          "args": ["/bin/start-flynn-controller", "scheduler"],
          "omni": true,
          "service": "controller-scheduler",
          "ports": [{ "proto": "tcp" }]
        },
        "worker": {
          "args": ["/bin/start-flynn-controller", "worker"],
          "ports": [{ "proto": "tcp" }]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=controller\u0026target=/images/a15ef2046b254e41f9e5acfda5767edf6efa4086dd6c0f47b4c8643fae279435.json","meta":{"flynn.component":"controller","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-controller"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786"},"id":"5eab8b09342a1bff1ed396d44dc4c79beda26d144c371175ab773b7babdbd786","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"b79c4fd1127ba65bed93de4116a4f2ea74eee72bea5e809cdbb4c96e77b9f3d4"},"id":"b79c4fd1127ba65bed93de4116a4f2ea74eee72bea5e809cdbb4c96e77b9f3d4","length":24190976,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"a15ef2046b254e41f9e5acfda5767edf6efa4086dd6c0f47b4c8643fae279435"},"size":660,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "web": 1
    },
    "resources": [{"name":"postgres", "url":"http://postgres-api.discoverd/databases"}]
  },
  {
    "id": "controller-wait",
    "action": "wait",
    "url": "http://controller.discoverd",
    "status": 401
  },
  {
    "id": "controller-inception",
    "action": "add-app",
    "from_step": "controller",
    "app": {
      "name": "controller",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one",
      "deploy_timeout": 120
    }
  },
  {
    "id": "postgres-app",
    "action": "add-app",
    "from_step": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "sirenia",
      "deploy_timeout": 120
    }
  },
  {
    "id": "flannel-app",
    "action": "add-app",
    "from_step": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one"
    }
  },
  {
    "id": "discoverd-app",
    "action": "add-app",
    "from_step": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "discoverd-meta",
      "deploy_timeout": 300
    }
  },
  {
    "id": "scheduler-scale",
    "action": "scale-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1,
      "worker": 2,
      "web": 2
    }
  },
  {
    "id": "scheduler",
    "action": "run-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1
    }
  },
