    "processes": {
      "app": 1
    }
  },
  {
    "id": "wait-hosts",
    "action": "wait-hosts"
  },
  {
    "id": "pg-password",
    "action": "gen-random"
  },
  {
    "id": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "FLYNN_POSTGRES": "postgres",
        "PGDATABASE": "postgres",
        "PGHOST": "leader.postgres.discoverd",
        "PGUSER": "flynn",
        "PGPASSWORD": "{{ (index .StepData \"pg-password\").Data }}",
        "SIRENIA_PROCESS": "postgres",
        "SINGLETON": "{{ .Singleton }}"
      },
      "processes": {
        "postgres": {
          "ports": [{"port": 5432, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "args": ["/bin/start-flynn-postgres", "postgres"],
          "service": "postgres"
        },
        "web": {
          "ports": [{"port": 80, "proto": "tcp"}],
          "args": ["/bin/start-flynn-postgres", "api"]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=postgres\u0026target=/images/08281efced21e7969b3f3b1085b1cab51712d69a40e986908777dae6a8d0f5a4.json","meta":{"flynn.component":"postgres","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-postgres"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"bc754e017aee8901d3545a0058aef366a55938f76cc03e302c83434118cb0f4a"},"id":"bc754e017aee8901d3545a0058aef366a55938f76cc03e302c83434118cb0f4a","length":166764544,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"7d32a952855e0ab405adadf2260d9878ffa002dc430b764d4b9daf51b3a7fce8"},"id":"7d32a952855e0ab405adadf2260d9878ffa002dc430b764d4b9daf51b3a7fce8","length":426815488,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"c306aa8d51692f1d93ab2a97affefd2cfe25e3d8af3ffa65cc13ff0303e72c5f"},"id":"c306aa8d51692f1d93ab2a97affefd2cfe25e3d8af3ffa65cc13ff0303e72c5f","length":12738560,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"08281efced21e7969b3f3b1085b1cab51712d69a40e986908777dae6a8d0f5a4"},"size":893,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "postgres": 3,
      "web": 2
    }
  },
  {
    "id": "controller-key",
    "action": "gen-random",
    "controller_key": true,
    "data": "{{ getenv \"CONTROLLER_KEY\" }}"
  },
  {
    "id": "bootstrap-id",
    "action": "gen-random",
    "encoding": "uuid"
  },
  {
    "id": "name-seed",
    "action": "gen-random",
    "length": 10
  },
  {
    "id": "router-sticky-key",
    "action": "gen-random",
    "length": 32,
    "encoding": "base64"
  },
  {
    "id": "postgres-wait",
    "action": "wait",
    "url": "http://postgres-api.discoverd/ping"
  },
  {
    "id": "controller-cert",
    "action": "gen-tls-cert",
    "hosts": ["{{ getenv \"CLUSTER_DOMAIN\" }}", "*.{{ getenv \"CLUSTER_DOMAIN\" }}"],
    "ca_cert": "{{ getenv \"TLS_CA\" }}",
    "cert": "{{ getenv \"TLS_CERT\" }}",
    "key": "{{ getenv \"TLS_KEY\" }}"
  },
  {
    "id": "controller",
    "action": "run-app",
    "app": {
      "name": "controller",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "release": {
      "env": {
        "AUTH_KEY": "{{ (index .StepData \"controller-key\").Data }}",
        "DEFAULT_ROUTE_DOMAIN": "{{ getenv \"CLUSTER_DOMAIN\" }}",
        "NAME_SEED": "{{ (index .StepData \"name-seed\").Data }}",
        "CA_CERT": "{{ (index .StepData \"controller-cert\").CACert }}",
        "TELEMETRY_BOOTSTRAP_ID": "{{ (index .StepData \"bootstrap-id\").Data }}",
        "TELEMETRY_CLUSTER_ID": "{{ (index .StepData \"bootstrap-id\").Data }}"
      },
      "processes": {
        "web": {
          "ports": [
            {"port": 80, "proto": "tcp"},
            {"port": 8080, "proto": "tcp"}
          ],
          "args": ["/bin/start-flynn-controller", "controller"],
          "service": "controller",
          "volumes": [{"path": "/tmp", "delete_on_stop": true}]
        },
        "scheduler": {
          "args": ["/bin/start-flynn-controller", "scheduler"],
          "omni": true,
          "service": "controller-scheduler",
          "ports": [{ "proto": "tcp" }]
        },
        "worker": {
          "args": ["/bin/start-flynn-controller", "worker"],
          "ports": [{ "proto": "tcp" }]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=controller\u0026target=/images/35b4f42db0007452008b76f5f5f81ef50744e116989da2ff4d1d903b7656ae32.json","meta":{"flynn.component":"controller","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-controller"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf"},"id":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"acf85bfb6f68476c4a77aaff734489924cf15d7e522b715e1fc0336a8bdeea12"},"id":"acf85bfb6f68476c4a77aaff734489924cf15d7e522b715e1fc0336a8bdeea12","length":22388736,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"35b4f42db0007452008b76f5f5f81ef50744e116989da2ff4d1d903b7656ae32"},"size":660,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "web": 1
    },
    "resources": [{"name":"postgres", "url":"http://postgres-api.discoverd/databases"}]
  },
  {
    "id": "controller-wait",
    "action": "wait",
    "url": "http://controller.discoverd",
    "status": 401
  },
  {
    "id": "controller-inception",
    "action": "add-app",
    "from_step": "controller",
    "app": {
      "name": "controller",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one",
      "deploy_timeout": 120
    }
  },
  {
    "id": "postgres-app",
    "action": "add-app",
    "from_step": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "sirenia",
      "deploy_timeout": 120
    }
  },
  {
    "id": "flannel-app",
    "action": "add-app",
    "from_step": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one"
    }
  },
  {
    "id": "discoverd-app",
    "action": "add-app",
    "from_step": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "discoverd-meta",
      "deploy_timeout": 300
    }
  },
  {
    "id": "scheduler-scale",
    "action": "scale-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1,
      "worker": 2,
      "web": 2
    }
  },
  {
    "id": "scheduler",
    "action": "run-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1
    }
  },
