[
  {
    "id": "require-env",
    "action": "require-env",
    "vars": ["CLUSTER_DOMAIN"]
  },
  {
    "id": "resource-check",
    "action": "resource-check",
    "ports": [
      { "port": 80 },
      { "port": 443 },
      { "port": 5002 },
      { "port": 1111 }
    ]
  },
  {
    "id": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD_PEERS": "{{ range $ip := .SortedHostIPs }}{{ $ip }}:1111,{{ end }}",
        "DISCOVERD": "none",
        "DEBUG": "{{ getenv \"DEBUG\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 1111, "proto": "tcp"}, {"port": 53, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "host_network": true,
          "omni": true,
          "service": "discoverd"
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=discoverd\u0026target=/images/7aa459f5fc282e3db59c12840aaf467b015f77193d4428d16f9e13c3e5fa3478.json","meta":{"flynn.component":"discoverd","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-discoverd"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf"},"id":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"9f8e7681e72ff059d69825814bb3b8464d339f8fa2469a24daedea488238acd0"},"id":"9f8e7681e72ff059d69825814bb3b8464d339f8fa2469a24daedea488238acd0","length":6799360,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"7aa459f5fc282e3db59c12840aaf467b015f77193d4428d16f9e13c3e5fa3478"},"size":652,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"}
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD": "none",
        "BACKEND": "{{ getenv \"FLANNEL_BACKEND\" }}",
        "NETWORK": "{{ getenv \"FLANNEL_NETWORK\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 5002, "proto": "tcp"}],
          "host_network": true,
          "omni": true
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=flannel\u0026target=/images/750dd150f3b43acd4f002fc34b490c6ad05cbeba47899f716a9245d8b519432a.json","meta":{"flynn.component":"flannel","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/flannel-wrapper"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf"},"id":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"58c5fdcbd472736e31eef5803d571ea31d4fb9ea916ea3bb206ef21e8a274777"},"id":"58c5fdcbd472736e31eef5803d571ea31d4fb9ea916ea3bb206ef21e8a274777","length":10883072,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"750dd150f3b43acd4f002fc34b490c6ad05cbeba47899f716a9245d8b519432a"},"size":653,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "wait-hosts",
    "action": "wait-hosts"
  },
  {
    "id": "pg-password",
    "action": "gen-random"
  },
  {
    "id": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "FLYNN_POSTGRES": "postgres",
        "PGDATABASE": "postgres",
        "PGHOST": "leader.postgres.discoverd",
        "PGUSER": "flynn",
        "PGPASSWORD": "{{ (index .StepData \"pg-password\").Data }}",
        "SIRENIA_PROCESS": "postgres",
        "SINGLETON": "{{ .Singleton }}"
      },
      "processes": {
        "postgres": {
          "ports": [{"port": 5432, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "args": ["/bin/start-flynn-postgres", "postgres"],
          "service": "postgres"
        },
        "web": {
          "ports": [{"port": 80, "proto": "tcp"}],
          "args": ["/bin/start-flynn-postgres", "api"]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=postgres\u0026target=/images/3412bf526370f9f30d1840fda10004bf9064ff3538f471b934dd19c6814b788c.json","meta":{"flynn.component":"postgres","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-postgres"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"bc754e017aee8901d3545a0058aef366a55938f76cc03e302c83434118cb0f4a"},"id":"bc754e017aee8901d3545a0058aef366a55938f76cc03e302c83434118cb0f4a","length":166764544,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"7d32a952855e0ab405adadf2260d9878ffa002dc430b764d4b9daf51b3a7fce8"},"id":"7d32a952855e0ab405adadf2260d9878ffa002dc430b764d4b9daf51b3a7fce8","length":426815488,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"71fc34e4594b157bf600ec19786728149a41466766d706ff0795fa0ef4bb1b6a"},"id":"71fc34e4594b157bf600ec19786728149a41466766d706ff0795fa0ef4bb1b6a","length":12804096,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"3412bf526370f9f30d1840fda10004bf9064ff3538f471b934dd19c6814b788c"},"size":893,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "postgres": 3,
      "web": 2
    }
  },
  {
    "id": "controller-key",
    "action": "gen-random",
    "controller_key": true,
    "data": "{{ getenv \"CONTROLLER_KEY\" }}"
  },
  {
    "id": "bootstrap-id",
    "action": "gen-random",
    "encoding": "uuid"
  },
  {
    "id": "name-seed",
    "action": "gen-random",
    "length": 10
  },
  {
    "id": "router-sticky-key",
    "action": "gen-random",
    "length": 32,
    "encoding": "base64"
  },
  {
    "id": "postgres-wait",
    "action": "wait",
    "url": "http://postgres-api.discoverd/ping"
  },
  {
    "id": "controller-cert",
    "action": "gen-tls-cert",
    "hosts": ["{{ getenv \"CLUSTER_DOMAIN\" }}", "*.{{ getenv \"CLUSTER_DOMAIN\" }}"],
    "ca_cert": "{{ getenv \"TLS_CA\" }}",
    "cert": "{{ getenv \"TLS_CERT\" }}",
    "key": "{{ getenv \"TLS_KEY\" }}"
  },
  {
    "id": "controller",
    "action": "run-app",
    "app": {
      "name": "controller",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "release": {
      "env": {
        "AUTH_KEY": "{{ (index .StepData \"controller-key\").Data }}",
        "DEFAULT_ROUTE_DOMAIN": "{{ getenv \"CLUSTER_DOMAIN\" }}",
        "NAME_SEED": "{{ (index .StepData \"name-seed\").Data }}",
        "CA_CERT": "{{ (index .StepData \"controller-cert\").CACert }}",
        "TELEMETRY_BOOTSTRAP_ID": "{{ (index .StepData \"bootstrap-id\").Data }}",
        "TELEMETRY_CLUSTER_ID": "{{ (index .StepData \"bootstrap-id\").Data }}"
      },
      "processes": {
        "web": {
          "ports": [
            {"port": 80, "proto": "tcp"},
            {"port": 8080, "proto": "tcp"}
          ],
          "args": ["/bin/start-flynn-controller", "controller"],
          "service": "controller",
          "volumes": [{"path": "/tmp", "delete_on_stop": true}]
        },
        "scheduler": {
          "args": ["/bin/start-flynn-controller", "scheduler"],
          "omni": true,
          "service": "controller-scheduler",
          "ports": [{ "proto": "tcp" }]
        },
        "worker": {
          "args": ["/bin/start-flynn-controller", "worker"],
          "ports": [{ "proto": "tcp" }]
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=controller\u0026target=/images/40efdf884f9eb90d66951a813511a41f2e68ef583b376115c8434727a55a3df4.json","meta":{"flynn.component":"controller","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-flynn-controller"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf"},"id":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"17851835fc91ad4e58b8c222b73512f45dfc53528c92dff26a5a9e6509de1a4d"},"id":"17851835fc91ad4e58b8c222b73512f45dfc53528c92dff26a5a9e6509de1a4d","length":22523904,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"40efdf884f9eb90d66951a813511a41f2e68ef583b376115c8434727a55a3df4"},"size":660,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "web": 1
    },
    "resources": [{"name":"postgres", "url":"http://postgres-api.discoverd/databases"}]
  },
  {
    "id": "controller-wait",
    "action": "wait",
    "url": "http://controller.discoverd",
    "status": 401
  },
  {
    "id": "controller-inception",
    "action": "add-app",
    "from_step": "controller",
    "app": {
      "name": "controller",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one",
      "deploy_timeout": 120
    }
  },
  {
    "id": "postgres-app",
    "action": "add-app",
    "from_step": "postgres",
    "app": {
      "name": "postgres",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "sirenia",
      "deploy_timeout": 120
    }
  },
  {
    "id": "flannel-app",
    "action": "add-app",
    "from_step": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"},
      "strategy": "one-by-one"
    }
  },
  {
    "id": "discoverd-app",
    "action": "add-app",
    "from_step": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      },
      "strategy": "discoverd-meta",
      "deploy_timeout": 300
    }
  },
  {
    "id": "scheduler-scale",
    "action": "scale-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1,
      "worker": 2,
      "web": 2
    }
  },
  {
    "id": "scheduler",
    "action": "run-app",
    "app_step": "controller-inception",
    "processes": {
      "scheduler": 1
    }
  },
