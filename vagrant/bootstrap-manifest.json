[
  {
    "id": "require-env",
    "action": "require-env",
    "vars": ["CLUSTER_DOMAIN"]
  },
  {
    "id": "resource-check",
    "action": "resource-check",
    "ports": [
      { "port": 80 },
      { "port": 443 },
      { "port": 5002 },
      { "port": 1111 }
    ]
  },
  {
    "id": "discoverd",
    "app": {
      "name": "discoverd",
      "meta": {
        "flynn-system-app": "true",
        "flynn-system-critical": "true"
      }
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD_PEERS": "{{ range $ip := .SortedHostIPs }}{{ $ip }}:1111,{{ end }}",
        "DISCOVERD": "none",
        "DEBUG": "{{ getenv \"DEBUG\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 1111, "proto": "tcp"}, {"port": 53, "proto": "tcp"}],
          "volumes": [{"path": "/data"}],
          "host_network": true,
          "omni": true,
          "service": "discoverd"
        }
      }
    },
    "artifacts": [{"type":"flynn","uri":"https://consolving.github.io/flynn-tuf-repo/repository?name=discoverd\u0026target=/images/c6f26d19f92f502ac5d64251d6908b0ad053ac2e91b4eb298a7a15690a12b1f8.json","meta":{"flynn.component":"discoverd","flynn.system-image":"true"},"manifest":{"_type":"application/vnd.flynn.image.manifest.v1+json","entrypoints":{"_default":{"args":["/bin/start-discoverd"]}},"rootfs":[{"layers":[{"hashes":{"sha512_256":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf"},"id":"965f3e6184ca4339cc1d186b5c5c41619c0bf8e4845a5fb53beb433ed3dcb0cf","length":2580480,"type":"application/vnd.flynn.image.squashfs.v1"},{"hashes":{"sha512_256":"b4174c575555e1acf714ca1ad8d455f0d11f6695229abefc8b91ab45d7c37331"},"id":"b4174c575555e1acf714ca1ad8d455f0d11f6695229abefc8b91ab45d7c37331","length":6758400,"type":"application/vnd.flynn.image.squashfs.v1"}],"platform":{"architecture":"amd64","os":"linux"}}]},"hashes":{"sha512_256":"c6f26d19f92f502ac5d64251d6908b0ad053ac2e91b4eb298a7a15690a12b1f8"},"size":652,"layer_url_template":"https://dl.consolving.net/{id}.squashfs"}],
    "processes": {
      "app": 1
    }
  },
  {
    "id": "flannel",
    "app": {
      "name": "flannel",
      "meta": {"flynn-system-app": "true"}
    },
    "action": "run-app",
    "release": {
      "env": {
        "DISCOVERD": "none",
        "BACKEND": "{{ getenv \"FLANNEL_BACKEND\" }}",
        "NETWORK": "{{ getenv \"FLANNEL_NETWORK\" }}"
      },
      "processes": {
        "app": {
          "ports": [{"port": 5002, "proto": "tcp"}],
          "host_network": true,
          "omni": true
        }
      }
    },
