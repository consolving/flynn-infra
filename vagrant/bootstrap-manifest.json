  {
    "id": "redis",
    "app": {
      "name": "redis",
      "meta": {"flynn-system-app": "true"}
    },
    "action": "deploy-app",
    "release": {
      "env": {
        "FLYNN_REDIS": "redis",
        "CONTROLLER_KEY": "{{ (index .StepData \"controller-key\").Data }}",
